#!/usr/bin/env bpftrace

#include <linux/bpf.h>

fexit:vmlinux:vm_normal_page
/ retval /
{
    $vaddr = args.addr;  // First argument to the function
    $page = (struct page *)retval;  // Return value of the function

    //$pfn = bpf_page_to_pfn($page);

    $pfn = ((unsigned long *)$page - (long)mem_map) / sizeof(struct page);
    printf("Follow Page: PID=%d, comm=%s, vaddr=0x%lx, pfn=0x%lx\n", pid, comm, $vaddr, $pfn);
}