#!/usr/bin/env bpftrace

tracepoint:exceptions:page_fault_user
/ pid == $1 /
{
    printf("User page fault: PID=%d, comm=%s, address=0x%lx, error_code=%d\n",
           pid, comm, args->address, args->error_code);
}

tracepoint:exceptions:page_fault_kernel
/ pid == $1 /
{
    printf("Kernel page fault: PID=%d, comm=%s, address=0x%lx, error_code=%d\n",
           pid, comm, args->address, args->error_code);
}

kprobe:handle_mm_fault 
/ pid == $1 /
{
    printf("handle_mm_fault called: PID=%d, comm=%s, vma=0x%lx, address=0x%lx, flags=0x%x\n", pid, comm, arg0, arg1, arg2);
}

tracepoint:kmem:mm_page_alloc
/ pid == $1 /
{
    printf("Page allocated: PID=%d, comm=%s, pfn=0x%lx, order=%d\n",
           pid, comm, args->pfn, args->order);
}