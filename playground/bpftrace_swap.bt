#!/usr/bin/env bpftrace


kprobe:swap_writepage
/ pid == $1 /
{
    // Zapis strony z RAM do swapu
    printf("swap_writepage: PID=%d, comm=%s, address=0x%lx\n", pid, comm, ((struct page *)arg0)->index);
}

kprobe:do_swap_page
/ pid == $1 /
{
    printf("do_swap_page called: PID=%d, comm=%s, address=0x%lx\n", pid, comm, ((struct vm_fault *)arg0)->address);
}